{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Product": {
      "title": "Product",
      "description": "A product for sale.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "code": { "type": "string" }
      },
      "required": ["userId", "name", "price", "code"]
    },
    "Customer": {
      "title": "Customer",
      "description": "A customer of the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["userId", "name", "mobile"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "An invoice created by the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerId": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/entities/InvoiceItem" }
        }
      },
      "required": ["userId", "invoiceNo", "date", "total", "items"]
    },
    "InvoiceItem": {
      "title": "InvoiceItem",
      "description": "An item in an invoice.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "qty": { "type": "number" },
        "price": { "type": "number" }
      },
      "required": ["name", "qty", "price"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products catalog"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customers list"
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Invoices"
    }
  }
}
